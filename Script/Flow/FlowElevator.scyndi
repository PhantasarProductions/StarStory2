Script

#use "Script/Use/Anyway"
#use "Libs/LinkedList"

#use "Libs/SCI/Sys"
#use "Libs/SCI/Events"
#use "Libs/SCI/Graphics"
#use "Libs/SCI/InterVar"

LocExtern Zelf "self"

Class Floor

	
	ReadOnly Int IDN
	
	Get String ID2FMT
		return sPrintF("%03d",math.max(0,IDN))
	End
	
	Get String ID2Floor
		Return "#"..ID2FMT
	End
	
	Const Bool Always = true
	Get Bool KeyCard
		return gBool[sPrintF("EFU_KEY_RED_%03d",math.max(0,IDN-1))]
	end
	
	ReadOnly String UnLockCheck
	
	Get Bool UnLocked
		return Zelf[UnLockCheck]
	End
	
	ReadOnly String KthMap
	ReadOnly String Layer
	ReadOnly String Start
	
	ReadOnly Int X
	ReadOnly Int Y
	
	Get Int DX
		Return (X*150)+5
	End
	
	Get Int DY
		Return Y*75
	End
	
	Static Var BRed
	Static Var BGreen
	Static Var BGreenHover
	
	Static ReadOnly Var Font = ObtainFont("BOXTEXT")
	
	Static Get Int MX
		Return Events.MouseX
	End
	Static Get Int MY
		Return Events.MouseY
	End
	Static Get Bool ML
		Return Events.MouseHitLeft
	End
	
	Get Bool Hovering
		Return MX>=DX && MY>=DY && MX<=DX+70 && MY<=DY+70
	End	
	
	Get Var Button
		If !Unlocked
			BRed = BRed || LoadNewImage("GFX/Elevator/Red.png","EFU_ELERED")
			Return BRed
		ElseIf Hovering
			BGreenHover = BGreenHover || LoadNewImage("GFX/Elevator/Green Hover.png","EFU_ELEGREENHOVER")
			Return BGreenHover
		Else
			BGreen = BGreen || LoadNewImage("GFX/Elevator/Green Hover.png","EFU_ELEGREENHOVER")
			Return BGreen
		End
	End
		
		
	
	Static ReadOnly Var List = New TLinkedList()
		
	Static Void DrawAll(IgnoreClick)
		For FL in List.Each
			FL.Draw(IgnoreClick)
		End
	End
		
	
	Get String Label
		if IDN<0
			return sprintf("B%d",math.abs(IDN))
		else
			return sprintf("%d",IDN)
		End
	End
	
	
	Void Draw(IgnoreClick)
		__White
		Button.Draw(DX,DY)
		Font.Text(Label,DX+90,DY+35,2,2)
		If (!IgnoreClick) && Hovering && ML && Unlocked
			Events.Flush()
			CSayF("Clicked on button %d",IDN)
			If (Upper(Lnk.Map.LoadedMap)!=Upper(KthMap))
				Lnk.Map.GoToMap(KthMap,Layer,Start)
				Sys.CurrentFlow="FIELD"
			Else
				Lnk.Map.GoToLayer(Layer,Start)
			End
			Sys.CurrentFlow="FIELD"
		End
		
	End
	


	
	Constructor(Int _IDN,String _KTh, String _Lay,String _ULC="KeyCard",String _S="Start")
		UnLockCheck=_ULC
		KthMap=_KTH
		Layer=_Lay
		IDN=_IDN
		Start=_S
		X = List.Count div 8
		Y = List.Count % 8
		List.AddLast(Self)
		CSayF("Floor %s pos(%2d,%2d) added to elevator",ID2Floor,X,Y)
	End
		
End


Init
	CSay("EFU Heaquarters: Elevator Floor Initiation")
	Var NL
	For i=20,11,-1
		NL = New Floor(i,"015_EFU_HQ_2",sprintf("#%03d",i))
		CSayF("Floors: %d",NL.List.Count)
	End
		For i=10,1,-1
		NL = New Floor(i,"014_EFU_HQ_1",sprintf("#%03d",i))
		CSayF("Floors: %d",NL.List.Count)
	End
	NL = New Floor(0,"014_EFU_HQ_1","#000","Always")
	NL = New Floor(-1,"013_Basement","#001","Always")
	CSayF("Floors: %d After ground floor and basement were added",NL.List.Count)
End

Global Const Var PartyRightClick = NIKS
Global Const Var PartyClick = NIKS

Global Void PRGL() 
		Floor.DrawAll()
End

Global Void MainFlow()
	Floor.DrawAll()
	Lnk.Party.Boxes()
	//__Dev.ToConsole()
	WantQuit()
	__Mouse.Draw()	
End
